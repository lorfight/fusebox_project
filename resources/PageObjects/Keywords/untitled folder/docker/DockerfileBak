# Use an official Python runtime as a parent image
FROM python:3.8-slim

# Set environment variables for Python to run in unbuffered mode
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

# Set a default value for the ENVIRONMENT variable
ENV ENVIRONMENT=dev

# Set the working directory in the container
WORKDIR /usr/src/app

# Install Chrome for Selenium
RUN apt-get update && apt-get install -y wget gnupg2 inotify-tools
RUN wget https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
RUN dpkg -i google-chrome-stable_current_amd64.deb; apt-get -fy install

# Install ChromeDriver
RUN wget -q "https://chromedriver.storage.googleapis.com/$(wget -qO- chromedriver.storage.googleapis.com/LATEST_RELEASE)/chromedriver_linux64.zip"
RUN unzip chromedriver_linux64.zip && mv chromedriver /usr/local/bin/ && chmod +x /usr/local/bin/chromedriver

# Install dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy the current directory contents into the container at /usr/src/app
COPY . .

# Command to run when starting the container
CMD ["python", "runner.py", "${ENVIRONMENT}"]
