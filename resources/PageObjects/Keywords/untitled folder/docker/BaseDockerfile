FROM selenium/standalone-chrome:latest

USER root

ENV PATH="/root/miniconda3/bin:${PATH}"
ARG PATH="/root/miniconda3/bin:${PATH}"

ENV ALLURE_VERSION=2.32.0
ENV ALLURE_DOWNLOAD_URL=https://github.com/allure-framework/allure2/releases/download/${ALLURE_VERSION}/allure-${ALLURE_VERSION}.tgz

RUN apt-get update && \
    apt-get install -y wget bzip2 libxml2-dev libxslt-dev curl tar openjdk-11-jdk && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Miniconda
RUN arch=$(uname -m) && \
    if [ "$arch" = "x86_64" ]; then \
    MINICONDA_URL="https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh"; \
    elif [ "$arch" = "aarch64" ]; then \
    MINICONDA_URL="https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-aarch64.sh"; \
    else \
    echo "Unsupported architecture: $arch"; \
    exit 1; \
    fi && \
    wget $MINICONDA_URL -O miniconda.sh && \
    mkdir -p /root/.conda && \
    bash miniconda.sh -b -p /root/miniconda3 && \
    rm -f miniconda.sh

# Allure Report
RUN curl -sSL $ALLURE_DOWNLOAD_URL -o /tmp/allure.tgz && \
    tar -xzf /tmp/allure.tgz -C /opt/ && \
    mv /opt/allure-${ALLURE_VERSION} /opt/allure && \
    rm /tmp/allure.tgz && \
    ln -s /opt/allure/bin/allure /usr/local/bin/allure

WORKDIR /app

COPY conda.yaml /app
COPY requirements.txt /app

SHELL ["/bin/bash", "--login", "-c"]

RUN conda env create -n fusebox -f conda.yaml  \
    && conda init bash \
    && echo "conda activate fusebox" >> ~/.bashrc \
    && conda install python=3.10

RUN pip install -r requirements.txt \
    && printenv